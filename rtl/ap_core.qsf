# independent altera_pll (100 MHz, refclk clk_74a) rather than a re-tune of
# mf_pllbase_0002's unused 133.12 MHz outputs -- altera_pll re-solves the whole
# VCO, and the video PLL's realized frequency is a 60.000000 Hz frame contract.
#
# on the old netlist) was measured against the old file list and the old
# single-fit number from here on.
# and give back ~144 M10K blocks.  Both files are new netlist content, so this
#     CURRENT one) at the 99.01 MHz CPU request, ranked on clk_cpu because the
#     CPU has its own PLL now and clk_74a closing says nothing about it:
#       1 -> 12.960 ns (77.2 MHz)     4 -> 13.508 (74.0)
#       2 -> 12.582 ns (79.5 MHz)     5 -> 12.834 (77.9)
#       3 -> 12.765 ns (78.3 MHz)     6 -> 13.703 (73.0)
# list change invalidates this one too.  Re-sweep with

# ---------------------------------------------------------------------------
# EXPERIMENT SWITCH — the video capture clock's 90-degree phase (core_top.v).
# Uncommenting the next line drives the platform's capture clock
# (video_rgb_clock_90 -> apf_top's `isclk` -> the scaler's `scal_clk` pad) from
# the 0-degree pixel-clock net instead of the PLL's 90-degree output: no second
# clock, no phase.  The link is DDR, so a 0-degree capture edge lands on the
# data transitions — this is expected to break the picture (see the WHY block
# build can let the panel answer the question.  Default = OFF = the proven
# hardware arrangement; if a build with it ever comes back clean, this is the
# shape to keep and outclk_1 + phase_shift1 can be deleted for good.
# set_global_assignment -name VERILOG_MACRO "VID_NO_CLOCK90"
# ---------------------------------------------------------------------------




# ===========================================================================
# Source file list -- GameTank.
#
# Everything sits in the flat rtl/ directory; every path below is relative
# to it, so the build runs from rtl/.
# ===========================================================================

# ---- APF framework --------------------------------------------------------
set_global_assignment -name VERILOG_FILE apf_top.v
set_global_assignment -name VERILOG_FILE common.v
set_global_assignment -name VERILOG_FILE io_bridge_peripheral.v
set_global_assignment -name VERILOG_FILE io_pad_controller.v
set_global_assignment -name VERILOG_FILE mf_datatable.v
set_global_assignment -name VERILOG_FILE mf_ddio_bidir_12.v
set_global_assignment -name QIP_FILE mf_datatable.qip
set_global_assignment -name QIP_FILE mf_ddio_bidir_12.qip

# ---- core_top: the APF wrapper --------------------------------------------
set_global_assignment -name VERILOG_FILE core_top.v
# The boot cartridge ($readmemh of bootcart.mem, resolved from this directory)
set_global_assignment -name VERILOG_FILE bootcart_rom.v
set_global_assignment -name SYSTEMVERILOG_FILE gametank.sv
set_global_assignment -name SYSTEMVERILOG_FILE gt_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE gt_savestates.sv
set_global_assignment -name SYSTEMVERILOG_FILE gt_save_slot.sv
set_global_assignment -name SYSTEMVERILOG_FILE gt_save_file.sv
set_global_assignment -name SYSTEMVERILOG_FILE gt_nvram.sv
# The core's own .sav writer (target commands 0184/0188/0190/0192).
set_global_assignment -name SYSTEMVERILOG_FILE save_state_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE gt_state_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE gtvideo.sv
set_global_assignment -name SYSTEMVERILOG_FILE palette.sv
set_global_assignment -name SYSTEMVERILOG_FILE vram.sv
set_global_assignment -name SYSTEMVERILOG_FILE frame_snapshot.sv
set_global_assignment -name SYSTEMVERILOG_FILE mainbus.sv
set_global_assignment -name SYSTEMVERILOG_FILE blitter.sv
set_global_assignment -name SYSTEMVERILOG_FILE acp.sv
# The output stage: DAC level -> the Pocket's I2S (four-pole filter, pause mute).
set_global_assignment -name SYSTEMVERILOG_FILE gt_audio.sv
set_global_assignment -name SYSTEMVERILOG_FILE pads.sv
set_global_assignment -name SYSTEMVERILOG_FILE cart.sv
set_global_assignment -name SYSTEMVERILOG_FILE savectl.sv
set_global_assignment -name SYSTEMVERILOG_FILE mem_bus.sv
set_global_assignment -name SYSTEMVERILOG_FILE gram.sv
set_global_assignment -name SYSTEMVERILOG_FILE psram.sv
set_global_assignment -name VERILOG_FILE cpu_65c02.v
set_global_assignment -name VERILOG_FILE alu_65c02.v
set_global_assignment -name SYSTEMVERILOG_FILE via6522.v
set_global_assignment -name VERILOG_FILE mf_pll_gt_console.v
set_global_assignment -name VERILOG_FILE mf_pll_gt_video.v
set_global_assignment -name VERILOG_FILE core_bridge_cmd.v

# ---- clocks ---------------------------------------------------------------
# Two PLLs, both hand-written in the shape of the framework's own IP, so
# there is no .qip and nothing for the IP upgrader to regenerate:
#
#   mf_pll_gt_console.v  74.25 MHz -> 28.636364 MHz console, 12.288 MHz audio
#   mf_pll_gt_video.v    74.25 MHz -> 2.25 MHz pixel, plus its 90-degree twin
#
# The console rate is the NTSC colour subcarrier x 8 (315/11 MHz), the rate
# the real GameTank runs at, and 12.288 MHz / 256 is 48.000 kHz for the APF's
# audio. The video rate is 150 x 250 x 60 Hz: an exact 33:1 division of
# 74.25 MHz, so there is no fractional-N jitter on the DDR launch clock or on
# the quarter-period phase shift. Read both back in the fit report's PLL
# section.

# ---- timing constraints ---------------------------------------------------
# apf_constraints.sdc is Analogue's and says not to edit it: it already declares
# clk_74a/clk_74b/bridge_spiclk and calls derive_pll_clocks. gt_constraints.sdc
# is ours and holds only what the framework leaves out.
#
# ORDER IS PART OF THE CONSTRAINT. Quartus reads these in the order they appear
# here, and gt_constraints.sdc's whole job is to group clocks that apf's file
# creates -- so it has to be read second. In the 2026-10-24 fit it was listed
# first, every get_clocks filter in it matched nothing, and Quartus ignored the
# entire file (Warning 332049 at gt_constraints.sdc lines 98, 153, 154). With no
# groups and no false paths, TimeQuest timed the console -> video synchronisers
# as single-cycle transfers and reported -25.9 ns on a 673 ns clock.
set_global_assignment -name SDC_FILE apf_constraints.sdc
set_global_assignment -name SDC_FILE gt_constraints.sdc

# ---- save states ----------------------------------------------------------
#
# The whole stack, in the fit and in every simulation, from three files that do
# not exist upstream:
#
#   gt_savestates.sv          what a state IS and the order its regions are
#                             walked in: CPU and ACP state, the window
#                             registers, 32 KB of RAM, 4 KB of audio RAM,
#                             the framebuffer and the 6522.
#   save_state_controller.sv  the APF end: the 0x40000000 buffer the OS reads
#                             and writes, and the command handshake.
#   gt_state_buffer.sv        ONE 64-bit buffer for both directions (2026-10-24):
#                             the save drain and the load stage share it, with
#                             the host's port on clk_74a and the engine's on
#                             clk_core. As two arrays they were 135 M10K blocks
#                             and the core needed 351 against the device's 308.
#                             The whole state lands in it at the engine's own
#                             rate, so the machine is handed back while the
#                             host is still reading its 69,688 bytes out.
#
# This core carries its own save-state engine instead of the MiSTer
# framework's (savestates.vhd, statemanager.vhd, savestate_ui.sv): that one
# is written around a fixed six-region memory map with an SDRAM arbiter, and
# it brings MiSTer's keyboard slot shortcuts and its rewind ring buffer. On
# the Pocket the OS owns the slots and the file, and it asks the core for
# exactly one state at a time (commands 0x00A0/0x00A4).


set_global_assignment -name EDA_SIMULATION_TOOL "<None>"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS OFF
set_global_assignment -name OPTIMIZATION_MODE "BALANCED"
set_global_assignment -name OPTIMIZE_IOC_REGISTER_PLACEMENT_FOR_TIMING OFF
# DETAILED PATHS, NOT JUST THE SUMMARY (2026-11-09).
#
# `ap_core.sta.rpt` used to hold the four-line clock table and nothing else, so
# a failing `clk_74a` was a number with no cone behind it: "-5.178 ns" and no
# way to say which path. With this on, the fit writes the worst setup paths
# (from node, to node, per-stage delay) into the report, and a residual miss
# can be fixed at the logic that causes it instead of by guessing.
set_global_assignment -name TIMEQUEST_DO_REPORT_TIMING ON
